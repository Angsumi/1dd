rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Store Products catalog - shared live across buyer and owner devices
    match /store_products/{productId} {
      allow read, write: if true;
    }
    // Orders collection - shared live across customer, seller, and delivery devices
    match /store_orders/{orderId} {
      allow read, write: if true;
    }
  }
}
